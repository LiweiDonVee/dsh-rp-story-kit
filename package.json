{
  "name": "dsh-rp-story-kit",
  "version": "0.2.1",
  "description": "DSH 原生角色与玩家资产库：来源审阅、JSON/PNG 导入与数据内容包",
  "license": "MIT",
  "type": "module",
  "main": "dist/host.js",
  "exports": {".": "./dist/host.js", "./client": "./dist/client.js", "./package.json": "./package.json"},
  "files": ["dist", "cordis.patch.yml", "README.md", "LICENSE", "docs/architecture.md", "docs/transfer.md", "docs/acceptance.md", "docs/skill-evaluation.md", "examples"],
  "engines": {"node": ">=24", "dsh": ">=0.2.1-rc.3 <0.3.0-0"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-workspace"], "platform": "web"}},
  "scripts": {
    "test:host": "node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "test": "pnpm test:host && pnpm test:ui",
    "lint": "oxlint src tests scripts vitest.config.js --deny-warnings",
    "build": "node scripts/build.mjs",
    "check": "pnpm lint && pnpm test && pnpm build",
    "package": "pnpm build && node scripts/pack.mjs",
    "skill:check": "node scripts/check-skill.mjs"
  },
  "peerDependencies": {"react": "^18.3.1"},
  "devDependencies": {"@playwright/test": "^1.55.0", "@testing-library/jest-dom": "^6.6.3", "@testing-library/react": "^16.1.0", "esbuild": "^0.28.2", "jsdom": "^26.1.0", "oxlint": "^1.78.0", "react": "^18.3.1", "react-dom": "^18.3.1", "vitest": "^4.1.11"},
  "packageManager": "pnpm@11.9.0",
  "repository": {"type": "git", "url": "git+https://github.com/LiweiDonVee/dsh-rp-story-kit.git"}
}
